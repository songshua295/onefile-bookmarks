# =====================================================================
# 书签服务配置示例
# 用法:复制本文件为 .env(同目录),按需修改;Vercel 部署时改为配置环境变量
# 注意:所有变量均在每次请求时读取,修改 .env 后无需重启 serve.js
# =====================================================================

# ---------- 服务 ----------
# 本地 serve.js 的监听端口(Vercel 上无效,平台自动分配)
PORT=3000

# ---------- 存储后端(三选一)----------
# s3     = S3 兼容对象存储(AWS S3 / Cloudflare R2 / 阿里云 OSS / Bitiful / MinIO 等)
# webdav = WebDAV 网盘(坚果云、Alist 等)
# none   = 不配置云端,页面进入只读模式,数据来自本地 BOOKMARK_FILE
STORAGE_TYPE=none

# ---------- 上传行为 ----------
# overwrite = 每次上传覆盖 BOOKMARK_FILE 指定的主文件(简单,无历史版本)
# dated     = 每次上传生成带日期的新文件(如 favorites_2026_9_21.html),
#             并在云端维护 latest.json 指针;读取时优先跟随指针,指针缺失则扫描目录取日期最新的文件
UPLOAD_MODE=overwrite
# 主文件名:本地只读模式的数据文件;overwrite 模式的上传目标;"用本地文件覆盖云端"的强制目标
# (dated 模式上传的文件名固定为 favorites_年_月_日.html,不受此项影响)
BOOKMARK_FILE=favorites.html
# true  = 通过书签栏快速添加(bookmarklet)保存后自动上传,不弹确认
# false = 只保存到本地缓存,需手动点「上传」(默认)
AUTO_UPLOAD=false

# ---------- S3 兼容存储(STORAGE_TYPE=s3 时必填)----------
# 生效条件:S3_BUCKET 与 S3_ACCESS_KEY_ID 同时非空,否则自动降级为 none
S3_ENDPOINT=https://s3.bitiful.net
# 区域,多数兼容服务随意填;Bitiful 如 cn-east-1
S3_REGION=us-east-1
S3_BUCKET=your-bucket
# bucket 内的保存目录(前缀),留空则存在根目录;无需首尾斜杠
S3_PREFIX=bookmarks
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# ---------- WebDAV(STORAGE_TYPE=webdav 时必填)----------
# 生效条件:WEBDAV_URL 非空,否则自动降级为 none
# 填到目录级即可,结尾斜杠可有可无
#WEBDAV_URL=https://dav.example.com/dav/bookmarks
#WEBDAV_USERNAME=user
#WEBDAV_PASSWORD=pass

# ---------- AI 能力(AI 精搜 / AI 归类)----------
# 生效条件:AI_BASE_URL 与 AI_API_KEY 同时配置;任一缺失则界面上隐藏 AI 按钮
# 接口要求:OpenAI 兼容的 POST {BASE_URL}/chat/completions,支持 response_format=json_object
#AI_BASE_URL=https://api.openai.com/v1
#AI_API_KEY=sk-xxxx
# 模型名,默认 gpt-4o-mini
#AI_MODEL=gpt-4o-mini

# ---------- 访问密码(可选)----------
# 配置后:打开页面需输一次密码(派生令牌存浏览器,之后免输),所有 /api 请求
# 携带 x-auth 头或 ?auth= 参数校验;下载云端文件走 ?auth=。
# 留空或注释 = 无需密码,直接打开(默认)
#ACCESS_PASSWORD=

# =====================================================================
# 云端会自动维护的文件(非配置项,了解即可,勿手工编辑):
#   latest.json          dated 模式的当前文件指针
#   bookmarks_meta.json  最近打开记录 / 点击次数
# =====================================================================
